{%- comment -%}=== JAVASCRIPT — All functionality + Mobile fixes ==={%- endcomment -%}
<script>
(function(){
  'use strict';

  function ready(fn){
    if(document.readyState==='loading'){
      document.addEventListener('DOMContentLoaded',fn);
    } else {
      fn();
    }
  }

  ready(function(){

    /* ========================================
       GALLERY: Thumbnails, overlay, touch swipe
       ======================================== */
    var thumbs = document.querySelectorAll('.pnt-gal__thumb');
    var mainImgs = document.querySelectorAll('.pnt-gal__main-img');
    var mainGal = document.getElementById('pntMainGal');
    var ovl = document.getElementById('pntOverlay');
    var ovImg = document.getElementById('pntOvImg');
    var ovCount = document.getElementById('pntOvCount');
    var mediaUrls = [];
    var ovIdx = 0;

    mainImgs.forEach(function(img){
      mediaUrls.push(img.getAttribute('data-full') || img.src);
    });

    /* --- Active image switcher --- */
    function setActiveImage(idx){
      thumbs.forEach(function(t){ t.classList.remove('is-active'); });
      mainImgs.forEach(function(m){ m.classList.remove('is-active'); });
      if(thumbs[idx]) thumbs[idx].classList.add('is-active');
      if(mainImgs[idx]) mainImgs[idx].classList.add('is-active');
      if(thumbs[idx]){
        thumbs[idx].scrollIntoView({ behavior:'smooth', block:'nearest', inline:'center' });
      }
    }

    /* --- Thumbnail clicks --- */
    thumbs.forEach(function(th){
      th.addEventListener('click', function(){
        setActiveImage(parseInt(this.getAttribute('data-idx'), 10));
      });
      /* Keyboard support */
      th.addEventListener('keydown', function(e){
        if(e.key === 'Enter' || e.key === ' '){
          e.preventDefault();
          setActiveImage(parseInt(this.getAttribute('data-idx'), 10));
        }
      });
    });

    /* --- Click/tap main image → open overlay --- */
    mainGal.addEventListener('click', function(e){
      var img = e.target.closest('.pnt-gal__main-img');
      if(img){
        ovIdx = parseInt(img.getAttribute('data-idx'), 10);
        openOverlay();
      }
    });

    /* Keyboard on gallery container */
    mainGal.addEventListener('keydown', function(e){
      if(e.key === 'Enter' || e.key === ' '){
        e.preventDefault();
        var activeImg = mainGal.querySelector('.pnt-gal__main-img.is-active');
        if(activeImg){
          ovIdx = parseInt(activeImg.getAttribute('data-idx'), 10);
          openOverlay();
        }
      }
    });

    /* ---- Touch swipe on MAIN GALLERY IMAGE ---- */
    var touchStartX = 0;
    var touchStartY = 0;
    var touchEndX = 0;
    var isSwiping = false;
    var swipeThreshold = 50; /* min px to count as swipe */
    var swipeHint = document.getElementById('pntSwipeHint');

    /* Show swipe hint briefly if multiple images */
    if(mediaUrls.length > 1 && swipeHint){
      setTimeout(function(){
        swipeHint.style.opacity = '1';
        setTimeout(function(){ swipeHint.style.opacity = '0'; }, 2000);
      }, 800);
    }

    mainGal.addEventListener('touchstart', function(e){
      touchStartX = e.changedTouches[0].clientX;
      touchStartY = e.changedTouches[0].clientY;
      isSwiping = false;
    }, { passive: true });

    mainGal.addEventListener('touchmove', function(e){
      var dx = Math.abs(e.changedTouches[0].clientX - touchStartX);
      var dy = Math.abs(e.changedTouches[0].clientY - touchStartY);
      if(dx > dy && dx > 10){ isSwiping = true; }
    }, { passive: true });

    mainGal.addEventListener('touchend', function(e){
      touchEndX = e.changedTouches[0].clientX;
      var dx = touchEndX - touchStartX;
      var dy = Math.abs(e.changedTouches[0].clientY - touchStartY);

      /* Only trigger swipe if horizontal movement dominates */
      if(isSwiping && Math.abs(dx) > swipeThreshold && Math.abs(dx) > dy){
        var currentIdx = 0;
        mainImgs.forEach(function(m, i){ if(m.classList.contains('is-active')) currentIdx = i; });

        if(dx < 0){
          /* Swipe left → next */
          var nextIdx = (currentIdx + 1) % mainImgs.length;
          setActiveImage(nextIdx);
        } else {
          /* Swipe right → previous */
          var prevIdx = (currentIdx - 1 + mainImgs.length) % mainImgs.length;
          setActiveImage(prevIdx);
        }
        e.preventDefault();
      }
    }, { passive: false });

    /* ---- Overlay open/close ---- */
    function openOverlay(){
      ovImg.src = mediaUrls[ovIdx];
      ovCount.textContent = (ovIdx + 1) + ' / ' + mediaUrls.length;
      ovl.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      document.body.style.position = 'relative'; /* Android Chrome fix */
    }

    function closeOverlay(){
      ovl.classList.remove('is-open');
      document.body.style.overflow = '';
      document.body.style.position = '';
      ovImg.src = ''; /* Release memory on mobile */
    }

    function overlayPrev(){
      ovIdx = (ovIdx - 1 + mediaUrls.length) % mediaUrls.length;
      ovImg.src = mediaUrls[ovIdx];
      ovCount.textContent = (ovIdx + 1) + ' / ' + mediaUrls.length;
    }

    function overlayNext(){
      ovIdx = (ovIdx + 1) % mediaUrls.length;
      ovImg.src = mediaUrls[ovIdx];
      ovCount.textContent = (ovIdx + 1) + ' / ' + mediaUrls.length;
    }

    document.getElementById('pntOvClose').addEventListener('click', closeOverlay);
    document.getElementById('pntOvPrev').addEventListener('click', overlayPrev);
    document.getElementById('pntOvNext').addEventListener('click', overlayNext);

    /* Click backdrop to close */
    ovl.addEventListener('click', function(e){ if(e.target === ovl) closeOverlay(); });

    /* Keyboard nav in overlay */
    document.addEventListener('keydown', function(e){
      if(!ovl.classList.contains('is-open')) return;
      if(e.key === 'Escape') closeOverlay();
      if(e.key === 'ArrowLeft') overlayPrev();
      if(e.key === 'ArrowRight') overlayNext();
    });

    /* Touch swipe inside OVERLAY */
    var ovTouchStartX = 0;
    ovl.addEventListener('touchstart', function(e){
      ovTouchStartX = e.changedTouches[0].clientX;
    }, { passive: true });

    ovl.addEventListener('touchend', function(e){
      var dx = e.changedTouches[0].clientX - ovTouchStartX;
      if(Math.abs(dx) > 50){
        if(dx < 0) overlayNext();
        else overlayPrev();
      }
    }, { passive: true });

    /* ========================================
       VARIANT SELECTION
       ======================================== */
    var variants = {{ product.variants | json }};
    var optGroups = document.querySelectorAll('[data-opt-idx]');
    var selOpts = [];
    {%- for option in product.options_with_values -%}
      selOpts[{{ forloop.index0 }}] = {{ option.selected_value | json }};
    {%- endfor -%}

    optGroups.forEach(function(group){
      var btns = group.querySelectorAll('.pnt-vg__btn');
      btns.forEach(function(btn){
        btn.addEventListener('click', function(){
          var oi = parseInt(group.getAttribute('data-opt-idx'), 10);
          var val = this.getAttribute('data-val');
          selOpts[oi] = val;
          btns.forEach(function(b){
            b.classList.remove('is-sel');
            b.setAttribute('aria-pressed', 'false');
          });
          this.classList.add('is-sel');
          this.setAttribute('aria-pressed', 'true');
          var lbl = document.getElementById('pntOptLabel' + oi);
          if(lbl) lbl.textContent = val;
          updateVariant();
        });
      });
    });

    function updateVariant(){
      var matched = null;
      for(var i = 0; i < variants.length; i++){
        var v = variants[i];
        var ok = true;
        for(var j = 0; j < selOpts.length; j++){
          if(v.options[j] !== selOpts[j]){ ok = false; break; }
        }
        if(ok){ matched = v; break; }
      }
      if(!matched) return;

      document.getElementById('pntVarId').value = matched.id;

      var priceEl = document.getElementById('pntPrice');
      var cmpEl = document.getElementById('pntCmp');
      var badgeEl = document.getElementById('pntBadge');
      var stickyP = document.getElementById('pntStickyP');

      priceEl.textContent = fmtMoney(matched.price);
      if(stickyP) stickyP.textContent = fmtMoney(matched.price);

      if(matched.compare_at_price && matched.compare_at_price > matched.price){
        if(!cmpEl){
          cmpEl = document.createElement('span');
          cmpEl.className = 'pnt-info__cmp';
          cmpEl.id = 'pntCmp';
          priceEl.parentNode.insertBefore(cmpEl, priceEl.nextSibling);
        }
        if(!badgeEl){
          badgeEl = document.createElement('span');
          badgeEl.className = 'pnt-info__badge';
          badgeEl.id = 'pntBadge';
          cmpEl.parentNode.insertBefore(badgeEl, cmpEl.nextSibling);
        }
        cmpEl.textContent = fmtMoney(matched.compare_at_price);
        cmpEl.style.display = '';
        var sv = Math.round((matched.compare_at_price - matched.price) / matched.compare_at_price * 100);
        badgeEl.textContent = 'Save ' + sv + '%';
        badgeEl.style.display = '';
      } else {
        if(cmpEl) cmpEl.style.display = 'none';
        if(badgeEl) badgeEl.style.display = 'none';
      }

      var atc = document.getElementById('pntAtc');
      var stickyAtc = document.getElementById('pntStickyAtc');

      if(matched.available){
        atc.disabled = false;
        atc.textContent = 'Add to Cart';
        if(stickyAtc){ stickyAtc.disabled = false; stickyAtc.textContent = 'Add to Cart'; }
      } else {
        atc.disabled = true;
        atc.textContent = 'Sold Out';
        if(stickyAtc){ stickyAtc.disabled = true; stickyAtc.textContent = 'Sold Out'; }
      }

      /* Update URL without reload */
      try {
        var url = new URL(window.location.href);
        url.searchParams.set('variant', matched.id);
        history.replaceState({}, '', url.toString());
      } catch(e){}

      /* Switch gallery image to variant's featured media */
      if(matched.featured_image && matched.featured_image.src){
        var targetFile = matched.featured_image.src.split('?')[0].split('/').pop();
        mainImgs.forEach(function(img, idx){
          var imgFile = img.src.split('?')[0].split('/').pop();
          /* Remove size suffix like _800x800 */
          var imgBase = imgFile.replace(/_\d+x\d+(\.\w+)$/, '$1');
          var targetBase = targetFile.replace(/_\d+x\d+(\.\w+)$/, '$1');
          if(imgBase === targetBase || imgFile.indexOf(targetFile.split('.')[0].replace(/_\d+x\d+$/, '')) > -1){
            setActiveImage(idx);
          }
        });
      }
    }

    function fmtMoney(cents){
      return '\u20B9' + (cents / 100).toLocaleString('en-IN', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2
      });
    }

    /* ========================================
       QUANTITY
       ======================================== */
    var qi = document.getElementById('pntQi');

    document.getElementById('pntQm').addEventListener('click', function(){
      var v = parseInt(qi.value, 10) || 1;
      if(v > 1) qi.value = v - 1;
    });

    document.getElementById('pntQp').addEventListener('click', function(){
      var v = parseInt(qi.value, 10) || 1;
      qi.value = v + 1;
    });

    /* Prevent invalid quantity values */
    qi.addEventListener('change', function(){
      var v = parseInt(this.value, 10);
      if(isNaN(v) || v < 1) this.value = 1;
    });

    /* ========================================
       TABS
       ======================================== */
    document.querySelectorAll('[data-tab]').forEach(function(btn){
      btn.addEventListener('click', function(){
        var tId = this.getAttribute('data-tab');
        var parent = this.closest('.pnt-tabs');
        parent.querySelectorAll('.pnt-tabs__btn').forEach(function(b){
          b.classList.remove('is-active');
          b.setAttribute('aria-selected', 'false');
        });
        parent.querySelectorAll('.pnt-tabs__panel').forEach(function(p){
          p.classList.remove('is-active');
        });
        this.classList.add('is-active');
        this.setAttribute('aria-selected', 'true');
        var panel = document.getElementById(tId);
        if(panel) panel.classList.add('is-active');
      });
    });

    /* ========================================
       SIZE CHART MODAL
       ======================================== */
    var scModal = document.getElementById('pntScModal');
    var scOpen = document.getElementById('pntScOpen');

    if(scOpen){
      scOpen.addEventListener('click', function(e){
        e.preventDefault();
        scModal.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      });
    }

    function closeScModal(){
      scModal.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    document.getElementById('pntScClose').addEventListener('click', closeScModal);
    document.getElementById('pntScBg').addEventListener('click', closeScModal);

    document.addEventListener('keydown', function(e){
      if(e.key === 'Escape' && scModal.classList.contains('is-open')) closeScModal();
    });

    /* ========================================
       COPY COUPON CODE
       ======================================== */
    document.querySelectorAll('[data-cpcode]').forEach(function(el){
      function doCopy(self){
        var txt = self.textContent.trim();
        if(navigator.clipboard && navigator.clipboard.writeText){
          navigator.clipboard.writeText(txt).then(function(){
            showCopied(self, txt);
          }).catch(function(){ fallbackCopy(self, txt); });
        } else {
          fallbackCopy(self, txt);
        }
      }

      function fallbackCopy(self, txt){
        var ta = document.createElement('textarea');
        ta.value = txt;
        ta.style.cssText = 'position:fixed;top:-9999px;left:-9999px;opacity:0;';
        document.body.appendChild(ta);
        ta.focus();
        ta.select();
        try { document.execCommand('copy'); } catch(e){}
        document.body.removeChild(ta);
        showCopied(self, txt);
      }

      function showCopied(self, txt){
        self.textContent = 'Copied!';
        self.classList.add('is-copied');
        setTimeout(function(){
          self.textContent = txt;
          self.classList.remove('is-copied');
        }, 1800);
      }

      el.addEventListener('click', function(){ doCopy(this); });

      /* Touch support — trigger on touchend to avoid 300ms delay */
      el.addEventListener('touchend', function(e){
        e.preventDefault();
        doCopy(this);
      });
    });

    /* ========================================
       STICKY BAR — Android-safe scroll detection
       Uses IntersectionObserver with scroll fallback
       ======================================== */
    var sticky = document.getElementById('pntSticky');
    var atcBtn = document.getElementById('pntAtc');

    if(sticky && atcBtn){
      if('IntersectionObserver' in window){
        var obs = new IntersectionObserver(function(entries){
          entries.forEach(function(e){
            if(e.isIntersecting){
              sticky.classList.remove('is-vis');
            } else {
              sticky.classList.add('is-vis');
            }
          });
        }, { threshold: 0, rootMargin: '0px 0px 0px 0px' });
        obs.observe(atcBtn);
      } else {
        /* Fallback for older Android browsers */
        var atcRect = atcBtn.getBoundingClientRect();
        var atcAbsTop = atcRect.top + window.pageYOffset;

        window.addEventListener('scroll', function(){
          var scrollY = window.pageYOffset || document.documentElement.scrollTop;
          if(scrollY > atcAbsTop + atcRect.height){
            sticky.classList.add('is-vis');
          } else {
            sticky.classList.remove('is-vis');
          }
        }, { passive: true });
      }
    }

    /* ========================================
       RECENTLY VIEWED
       ======================================== */
    try {
      var rvp = JSON.parse(localStorage.getItem('theme:recently-viewed-products') || '[]');
      rvp = rvp.filter(function(x){ return x !== {{ product.id }}; });
      rvp.unshift({{ product.id }});
      if(rvp.length > 20) rvp = rvp.slice(0, 20);
      localStorage.setItem('theme:recently-viewed-products', JSON.stringify(rvp));
    } catch(e){}

  }); /* end ready */

})();
</script>

