          <div class="pnt-trust__item" role="listitem">
            <div class="pnt-trust__ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></div>
            <div><span class="pnt-trust__ttl">{{ section.settings.trust_1_title | default: 'Free Shipping' }}</span><span class="pnt-trust__sub">{{ section.settings.trust_1_sub | default: 'All across India' }}</span></div>
