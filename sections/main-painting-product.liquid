          {%- for media in product.media -%}
            <img
              class="pnt-gal__main-img {% if forloop.first %}is-active{% endif %}"
              src="{{ media | image_url: width: 1000 }}"
              alt="{{ media.alt | default: product.title | escape }}"
              data-idx="{{ forloop.index0 }}"
              data-full="{{ media | image_url: width: 2400 }}"
              loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
              width="1000" height="1000"
              draggable="false"
            >
          {%- endfor -%}
          <div class="pnt-gal__zoom-hint" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
          </div>
          <div class="pnt-gal__swipe-hint" id="pntSwipeHint" aria-hidden="true">Swipe to view more</div>
        </div>

        {%- comment -%}Thumbnails BELOW the main image{%- endcomment -%}
        {%- if product.media.size > 1 -%}
        <div class="pnt-gal__thumbs" id="pntThumbs" role="list" aria-label="Product images">
          {%- for media in product.media -%}
            <div
              class="pnt-gal__thumb {% if forloop.first %}is-active{% endif %}"
              data-idx="{{ forloop.index0 }}"
              role="listitem button"
              tabindex="0"
              aria-label="View image {{ forloop.index }}"
            >
              <img
                src="{{ media | image_url: width: 150 }}"
                alt="{{ media.alt | default: product.title | escape }}"
                width="68" height="68"
                loading="lazy"
              >
            </div>
          {%- endfor -%}
        </div>
        {%- endif -%}
      </div>

      {%- comment -%}========== RIGHT: PRODUCT INFO =========={%- endcomment -%}
      <div class="pnt-info">
        {%- if product.vendor != blank -%}
          <div class="pnt-info__vendor">{{ product.vendor }}</div>
        {%- endif -%}

        <h1 class="pnt-info__title">{{ product.title }}</h1>

        <div class="pnt-info__price-row">
          <span class="pnt-info__price" id="pntPrice">{{ cv.price | money }}</span>
          {%- if cv.compare_at_price > cv.price -%}
            <span class="pnt-info__cmp" id="pntCmp">{{ cv.compare_at_price | money }}</span>
            {%- assign sv = cv.compare_at_price | minus: cv.price | times: 100.0 | divided_by: cv.compare_at_price | round -%}
            <span class="pnt-info__badge" id="pntBadge">Save {{ sv }}%</span>
          {%- endif -%}
        </div>
        <p class="pnt-info__tax">Inclusive of all taxes</p>

        {% comment %} Add the live viewer counter {% endcomment %}
         {% render 'live-viewer-count',
          min_viewers: 70,
          max_viewers: 500,
          min_interval: 3,
          max_interval: 8
        %}
        

        {%- comment -%}=== PRODUCT FORM ==={%- endcomment -%}
        {%- form 'product', product, id: fid, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
          <input type="hidden" name="id" value="{{ cv.id }}" id="pntVarId">

          {%- for option in product.options_with_values -%}
            <div class="pnt-vg">
              <div class="pnt-vg__label">
                {{ option.name }}: <span id="pntOptLabel{{ forloop.index0 }}">{{ option.selected_value }}</span>
                {%- if option.name == 'Size' -%}
                  <button type="button" class="pnt-vg__sc-link" id="pntScOpen" aria-haspopup="dialog">[Size Chart]</button>
                {%- endif -%}
              </div>
              <div class="pnt-vg__opts" data-opt-idx="{{ forloop.index0 }}" role="group" aria-label="{{ option.name }} options">
                {%- for value in option.values -%}
                  <button
                    type="button"
                    class="pnt-vg__btn {% if value == option.selected_value %}is-sel{% endif %}"
                    data-val="{{ value | escape }}"
                    aria-pressed="{% if value == option.selected_value %}true{% else %}false{% endif %}"
                  >{{ value }}</button>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}

          <div class="pnt-qty-row">
            <div class="pnt-vg__label pnt-mb0">Quantity</div>
            <div class="pnt-qty" role="group" aria-label="Quantity">
              <button type="button" class="pnt-qty__b" id="pntQm" aria-label="Decrease quantity">−</button>
              <input
                type="number"
                name="quantity"
                value="1"
                min="1"
                max="99"
                class="pnt-qty__i"
                id="pntQi"
                aria-label="Quantity"
                inputmode="numeric"
                pattern="[0-9]*"
              >
              <button type="button" class="pnt-qty__b" id="pntQp" aria-label="Increase quantity">+</button>
            </div>
          </div>

          <div>
             <a 
                href="https://api.whatsapp.com/send?phone=919818821453&text=Hi%2C%20I%20want%20to%20buy%20{{ product.title | url_encode }}%20in%20bulk. Can you please help me for the same ?"
                target="_blank"
                class="pf-bulk-button"
              >
                Want to buy this in bulk? Click here
              </a>

              <style>
              .pf-bulk-button {
                display: inline-block;
                font-size: 14px;
                font-weight: 600;
                color: #c49b66; 
                text-decoration: underline;
                margin-bottom : 5px;
              }

