<!-- ======================================== -->
<!-- JS: Smooth scroll + Catalogue Modal      -->
<!-- ======================================== -->
<script>
document.addEventListener('DOMContentLoaded', function() {

  /* ---- Smooth scroll for internal CTAs ---- */
  document.querySelectorAll('a[href^="#bulk-"]').forEach(function(el) {
    el.addEventListener('click', function(e) {
      var target = document.querySelector(this.getAttribute('href'));
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  /* ---- Catalogue Modal Logic ---- */
  var backdrop = document.getElementById('catModalBackdrop');
  var modal = document.getElementById('catModal');
  var openBtns = document.querySelectorAll('.openCatalogueBtn');
  var closeBtn = document.getElementById('catModalClose');
  var submitBtn = document.getElementById('catSubmitBtn');
  var step1 = document.getElementById('catStep1');
  var step2 = document.getElementById('catStep2');
  var errorEl = document.getElementById('catError');
  var userNameEl = document.getElementById('catUserName');

  var nameInput = document.getElementById('cat-name');
  var emailInput = document.getElementById('cat-email');
  var phoneInput = document.getElementById('cat-phone');
  var companyInput = document.getElementById('cat-company');

  function openModal() {
    backdrop.classList.add('is-active');
    document.body.style.overflow = 'hidden';
    // Reset to step 1 each time
    step1.classList.remove('cat-modal__step--hidden');
    step2.classList.add('cat-modal__step--hidden');
    errorEl.textContent = '';
    // Focus first input after animation
    setTimeout(function() { nameInput.focus(); }, 400);
  }

  function closeModal() {
    backdrop.classList.remove('is-active');
    document.body.style.overflow = '';
  }

  openBtns.forEach(function(btn) { btn.addEventListener('click', openModal); });
  closeBtn.addEventListener('click', closeModal);

  // Close on backdrop click (not modal itself)
  backdrop.addEventListener('click', function(e) {
    if (e.target === backdrop) closeModal();
  });

  // Close on Escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && backdrop.classList.contains('is-active')) closeModal();
  });

  // Simple email regex
  function isValidEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  // Simple phone regex (at least 7 digits)
  function isValidPhone(phone) {
    return phone.replace(/[^0-9]/g, '').length >= 7;
  }

  // Clear invalid state on input
  [nameInput, emailInput, phoneInput].forEach(function(inp) {
    inp.addEventListener('input', function() {
      this.classList.remove('is-invalid');
      errorEl.textContent = '';
    });
  });

  submitBtn.addEventListener('click', function() {
    var name = nameInput.value.trim();
    var email = emailInput.value.trim();
    var phone = phoneInput.value.trim();
    var company = companyInput.value.trim();
    var valid = true;

    // Reset
    [nameInput, emailInput, phoneInput].forEach(function(inp) {
      inp.classList.remove('is-invalid');
    });
    errorEl.textContent = '';

    if (!name) {
      nameInput.classList.add('is-invalid');
      valid = false;
    }
    if (!email || !isValidEmail(email)) {
      emailInput.classList.add('is-invalid');
      valid = false;
    }
    if (!phone || !isValidPhone(phone)) {
      phoneInput.classList.add('is-invalid');
      valid = false;
    }

    if (!valid) {
      errorEl.textContent = 'Please fill in all required fields correctly.';
      return;
    }

    // Disable button while "submitting"
    submitBtn.disabled = true;
    submitBtn.textContent = 'Processing...';

    /* 
      =====================================================
      SEND LEAD DATA
      =====================================================
      Option A (Recommended): Submit to Shopify contact form
      so it appears in your Shopify admin under Customers.
      We use a hidden iframe POST for seamless submission.
      
      Option B: If you have a CRM/Zapier webhook, replace 
      the fetch URL below with your endpoint.
      =====================================================
    */

    // Create a hidden form to submit to Shopify's contact endpoint
    var hiddenForm = document.createElement('form');
    hiddenForm.method = 'POST';
    hiddenForm.action = '/contact';
    hiddenForm.style.display = 'none';
    hiddenForm.target = 'cat-hidden-frame';

    // Shopify contact form fields
    var fields = {
      'form_type': 'contact',
      'utf8': '✓',
      'contact[catalogue_request]': 'Yes',
      'contact[full_name]': name,
      'contact[email]': email,
      'contact[phone]': phone,
      'contact[company_name]': company || 'N/A',
      'contact[body]': 'Catalogue download request from: ' + name + ' | ' + email + ' | ' + phone + (company ? ' | ' + company : '')
    };

    for (var key in fields) {
      var input = document.createElement('input');
      input.type = 'hidden';
      input.name = key;
      input.value = fields[key];
      hiddenForm.appendChild(input);
    }

    // Create hidden iframe target
    var iframe = document.createElement('iframe');
    iframe.name = 'cat-hidden-frame';
    iframe.style.display = 'none';
    document.body.appendChild(iframe);
    document.body.appendChild(hiddenForm);

    hiddenForm.submit();

    // After a brief delay, show success step
    setTimeout(function() {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Get Catalogue';

      // Show step 2
      userNameEl.textContent = name.split(' ')[0];
      step1.classList.add('cat-modal__step--hidden');
      step2.classList.remove('cat-modal__step--hidden');

      // Cleanup
      document.body.removeChild(hiddenForm);
      document.body.removeChild(iframe);
    }, 1200);
  });

  /* ---- Auto-trigger modal after 45 seconds (non-intrusive) ---- */
  /* Only triggers once per session, and only if user hasn't opened it */
  var modalTriggered = false;
  
  // Check sessionStorage to avoid repeat triggers
  try {
    if (sessionStorage.getItem('pf_cat_shown')) modalTriggered = true;
  } catch(e) {}

  if (!modalTriggered) {
    setTimeout(function() {
      if (!backdrop.classList.contains('is-active') && !modalTriggered) {
        modalTriggered = true;
        try { sessionStorage.setItem('pf_cat_shown', '1'); } catch(e) {}
        openModal();
      }
    }, 45000); // 45 seconds — plenty of time for user to engage first
  }

});
</script>
