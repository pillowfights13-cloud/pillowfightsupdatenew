    border: 1px solid var(--bulk-border);
    transition: border-color 0.3s ease;
  }

  .bulk-why__item:hover {
    border-color: var(--bulk-gold);
  }

  .bulk-why__item strong {
    font-size: 15px;
    font-weight: 600;
    color: var(--bulk-black);
    display: block;
    margin-bottom: 8px;
  }

  .bulk-why__item p {
    font-size: 13px;
    color: var(--bulk-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  /* Stats */
  .bulk-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 48px;
    margin-top: 48px;
    padding: 40px 0;
    border-top: 1px solid var(--bulk-border);
    border-bottom: 1px solid var(--bulk-border);
  }

  .bulk-stats__item {
    text-align: center;
  }

  .bulk-stats__num {
    display: block;
    font-size: clamp(28px, 5vw, 42px);
    font-weight: 300;
    color: var(--bulk-gold);
    letter-spacing: 1px;
    line-height: 1;
  }

  .bulk-stats__label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--bulk-text-muted);
    margin-top: 10px;
  }

  .bulk-stats__divider {
    width: 1px;
    height: 50px;
    background: var(--bulk-border);
  }

  /* Trust */
  .bulk-trust {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 28px;
    margin-top: 32px;
    font-size: 13px;
    color: var(--bulk-text-muted);
    letter-spacing: 0.5px;
  }

  .bulk-trust span {
    color: var(--bulk-text);
    font-weight: 500;
  }

  /* ================================ */
  /* TESTIMONIALS                     */
  /* ================================ */
  .bulk-testimonials {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: 40px;
  }

  .bulk-testimonials__card {
    padding: 28px;
    border: 1px solid rgba(255,255,255,0.1);
  }

