<!-- SECTION 8 — CONTACT FORM                 -->
<!-- ======================================== -->
<div class="bulk-form-section" id="bulk-form">
  <div class="bulk-container">

    <div class="bulk-form-section__head">
      <h2>Get Your Gifting Quote</h2>
      <p>Tell us about your needs, and we'll create a personalised proposal within 24 hours.</p>
    </div>

    <div class="bulk-form-wrap">
      {% form 'contact' %}

        <div class="bulk-form-row">
          <div class="bulk-field">
            <label for="bulk-fullname">Full Name <span>*</span></label>
            <input required type="text" name="contact[full_name]" id="bulk-fullname" placeholder="Your full name">
          </div>
          <div class="bulk-field">
            <label for="bulk-company">Company Name <span>*</span></label>
            <input required type="text" name="contact[company_name]" id="bulk-company" placeholder="Your company name">
          </div>
        </div>

        <div class="bulk-form-row">
          <div class="bulk-field">
            <label for="bulk-phone">Phone</label>
            <input type="tel" name="contact[phone]" id="bulk-phone" placeholder="e.g. +91 98765 43210">
          </div>
          <div class="bulk-field">
            <label for="bulk-email">Email <span>*</span></label>
            <input required type="email" name="contact[email]" id="bulk-email" placeholder="you@company.com">
          </div>
        </div>

        <div class="bulk-form-row">
          <div class="bulk-field">
            <label for="bulk-budget">Select Budget</label>
            <select name="contact[budget]" id="bulk-budget">
              <option selected value="Below ₹999">Below ₹999</option>
              <option value="₹999 - ₹2000">₹999 – ₹2,000</option>
              <option value="₹2000 - ₹3000">₹2,000 – ₹3,000</option>
              <option value="₹3000 - ₹5000">₹3,000 – ₹5,000</option>
              <option value="Above ₹5000">Above ₹5,000</option>
            </select>
          </div>
          <div class="bulk-field">
            <label for="bulk-quantity">Quantity</label>
            <select name="contact[quantity]" id="bulk-quantity">
              <option value="0 - 50">0 – 50</option>
              <option value="50 - 100">50 – 100</option>
              <option value="More than 100">More than 100</option>
            </select>
          </div>
        </div>

        <div class="bulk-field">
          <label for="bulk-message">Message (Optional)</label>
          <textarea name="contact[body]" id="bulk-message" rows="3" placeholder="Tell us more about your requirement..."></textarea>
        </div>

        <div class="bulk-field">
          <input type="submit" value="Submit Enquiry" class="bulk-btn bulk-btn--dark bulk-btn--full">
        </div>

        <p class="bulk-form-note">We respond within 24 business hours. Your details are safe with us.</p>

      {% endform %}
    </div>

  </div>
</div>


<!-- ======================================== -->
<!-- SECTION 9 — FAQ                          -->
<!-- ======================================== -->
<div class="bulk-section">
  <div class="bulk-container">

    <div class="bulk-section__head">
      <div class="bulk-section__head-line"></div>
      <h2 class="bulk-section__head-title">Frequently Asked Questions</h2>
      <div class="bulk-section__head-line"></div>
    </div>

    <div class="bulk-faq">

      <details class="bulk-faq__item">
        <summary>What is the minimum order quantity?</summary>
        <p>Our minimum order quantity (MOQ) varies by product. Generally, it starts at 50 units for most items. For custom branding orders, the MOQ may be higher. Contact our bulk team for exact numbers for your specific requirements.</p>
      </details>

      <details class="bulk-faq__item">
        <summary>Do you offer better pricing for higher quantity?</summary>
        <p>Absolutely. We offer tiered pricing — the more you order, the better the per-unit rate. Share your quantity requirements and we'll provide you with the best possible pricing.</p>
      </details>

      <details class="bulk-faq__item">
        <summary>Can I get samples before placing a bulk order?</summary>
        <p>Yes, we encourage sampling. You can order individual products from our website to evaluate quality, or request a dedicated sample set at a nominal charge. Sample costs are adjusted against your first bulk order.</p>
      </details>

      <details class="bulk-faq__item">
        <summary>What is the production timeline?</summary>
        <p>Standard bulk orders are fulfilled within 7–15 business days depending on quantity and customisation. Custom branding orders may take 15–25 business days. Rush orders can be accommodated during non-peak seasons.</p>
      </details>

      <details class="bulk-faq__item">
        <summary>Do you ship outside India?</summary>
        <p>Yes, we ship internationally. We have experience fulfilling export orders and handle all required documentation. International shipping timelines and costs vary by destination. Get in touch for a detailed quote.</p>
      </details>

      <details class="bulk-faq__item">
        <summary>What are the payment terms?</summary>
        <p>We typically work with 50% advance and 50% before dispatch for new clients. For repeat clients, we offer flexible terms. Bank transfer (NEFT/RTGS), UPI, and cheque payments are accepted.</p>
      </details>

    </div>

    <div class="bulk-cta-center" style="margin-top: 40px;">
      <a href="#bulk-form" class="bulk-btn bulk-btn--dark">Contact Bulk Team</a>
    </div>

  </div>
</div>


