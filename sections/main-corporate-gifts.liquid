    border: 1px solid var(--bulk-border);
    overflow: hidden;
    transition: border-color 0.3s ease;
    background: var(--bulk-white);
  }

  .bulk-products__card:hover {
    border-color: var(--bulk-gold);
  }

  .bulk-products__card-img {
    overflow: hidden;
    aspect-ratio: 1;
  }

  .bulk-products__card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .bulk-products__card:hover .bulk-products__card-img img {
    transform: scale(1.04);
  }

  .bulk-products__card-info {
    padding: 20px;
  }

  .bulk-products__card-info h3 {
    font-size: 18px;
    font-weight: 400;
    color: var(--bulk-black);
    margin: 0 0 8px 0;
    letter-spacing: 0.5px;
  }

  .bulk-products__card-info p {
    font-size: 13px;
    color: var(--bulk-text-muted);
    line-height: 1.5;
    margin: 0 0 12px 0;
  }

  .bulk-products__moq {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--bulk-gold);
  }

  /* ================================ */
  /* WHY CHOOSE US                    */
  /* ================================ */
  .bulk-why {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
