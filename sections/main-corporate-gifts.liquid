    display: none !important;
  }

  /* Remove any top spacing/margin left by the hidden header */
  body,
  #MainContent,
  .main-content,
  main {
    padding-top: 0 !important;
    margin-top: 0 !important;
  }

  /* ================================ */
  /* DESIGN SYSTEM                    */
  /* ================================ */
  :root {
    --bulk-gold: #C49B66;
    --bulk-gold-dark: #a8834f;
    --bulk-black: #000000;
    --bulk-dark: #1a1a1a;
    --bulk-white: #ffffff;
    --bulk-cream: #F9F6F1;
    --bulk-text: #333333;
    --bulk-text-muted: #777777;
    --bulk-border: #e8e3dc;
  }

  /* ================================ */
  /* GLOBAL BOX-SIZING                */
  /* ================================ */
  .bulk-container *,
  .bulk-container *::before,
  .bulk-container *::after,
  .bulk-heading *,
  .bulk-hero--desktop *,
  .bulk-hero-m *,
  .cat-modal *,
  .cat-modal *::before,
  .cat-modal *::after {
    box-sizing: border-box;
  }

  /* ================================ */
  /* LAYOUT                           */
  /* ================================ */
  .bulk-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .bulk-section {
    padding: 70px 0;
  }

  .bulk-section--cream {
    background: var(--bulk-cream);
  }

  .bulk-section--dark {
    background: var(--bulk-dark);
    color: var(--bulk-white);
  }

  /* ================================ */
  /* PAGE HEADING                     */
  /* ================================ */
  .bulk-heading {
    display: flex;
    align-items: center;
    padding: 39px 20px;
  }

  .bulk-heading__line {
    display: block;
    flex: 1;
    max-width: 350px;
    height: 1px;
    background: var(--bulk-black);
    margin: auto;
  }

  .bulk-heading__center {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-direction: column;
    flex-shrink: 0;
    padding: 0 24px;
  }

  .bulk-heading__title {
    font-size: clamp(18px, 4vw, 40px);
    font-weight: 300;
    line-height: 1.1;
    text-align: center;
    color: var(--bulk-black);
    letter-spacing: 3px;
  }

  .bulk-heading__sub {
    font-size: clamp(9px, 1.5vw, 12px);
    font-weight: 500;
    letter-spacing: 1.5px;
    text-align: center;
    color: var(--bulk-black);
  }

  /* ================================ */
  /* SECTION HEADINGS                 */
  /* ================================ */
  .bulk-section__head {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    margin-bottom: 16px;
  }

  .bulk-section__head-line {
    width: 80px;
    height: 1px;
    background: var(--bulk-black);
    flex-shrink: 0;
  }

  .bulk-section__head-line--light {
    background: rgba(255,255,255,0.3);
  }

  .bulk-section__head-title {
    font-size: clamp(16px, 3vw, 28px);
    font-weight: 300;
    letter-spacing: 2px;
    text-transform: uppercase;
    text-align: center;
    color: var(--bulk-black);
    white-space: nowrap;
  }

  .bulk-section__head-title--light {
    color: var(--bulk-white);
  }

  .bulk-section__subtitle {
    text-align: center;
    font-size: 15px;
    color: var(--bulk-text-muted);
    margin-bottom: 40px;
  }

  /* ================================ */
  /* BUTTONS                          */
  /* ================================ */
  .bulk-btn {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    padding: 14px 36px;
    border: none;
    cursor: pointer;
    transition: opacity 0.3s ease, transform 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }

  .bulk-btn:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .bulk-btn--gold {
    background: var(--bulk-gold);
    color: var(--bulk-white);
  }

  .bulk-btn--dark {
    background: var(--bulk-black);
    color: var(--bulk-white);
  }

  .bulk-btn--outline {
    background: transparent;
    color: var(--bulk-white);
    border: 1.5px solid var(--bulk-white);
  }

  .bulk-btn--outline:hover {
    background: var(--bulk-white);
    color: var(--bulk-black);
    opacity: 1;
  }

  .bulk-btn--full {
    width: 100%;
    text-align: center;
  }

  .bulk-cta-center {
    text-align: center;
    margin-top: 48px;
  }

  /* ================================ */
  /* HERO — DESKTOP (Video)          */
  /* ================================ */
  .bulk-hero--desktop {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .bulk-hero__video {
    width: 100%;
    height: 80vh;
    min-height: 480px;
    max-height: 720px;
    display: block;
    object-fit: cover;
  }

  .bulk-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0,0,0,0.25) 0%,
      rgba(0,0,0,0.6) 50%,
      rgba(0,0,0,0.75) 100%
