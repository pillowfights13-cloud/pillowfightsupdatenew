  .bulk-hero__content {
    text-align: center;
    max-width: 900px;
    padding: 40px 32px;
    color: var(--bulk-white);
  }

  .bulk-hero__kicker {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--bulk-gold);
    margin: 0 0 20px 0;
  }

  .bulk-hero__title {
    font-size: clamp(28px, 4.5vw, 50px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 1px;
    margin: 0 0 18px 0;
    text-transform: uppercase;
  }

  .bulk-hero__sub {
    font-size: clamp(14px, 2vw, 20px);
    letter-spacing: 2px;
    font-weight: 400;
    margin: 0 0 8px 0;
    opacity: 0.85;
  }

  .bulk-hero__moq {
    font-size: clamp(13px, 1.6vw, 16px);
    font-weight: 400;
    opacity: 0.55;
    margin: 0 0 32px 0;
  }

  .bulk-hero__btns {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  /* ================================ */
  /* HERO — MOBILE (Image + Text)     */
  /* ================================ */
  .bulk-hero-m {
    display: none; /* hidden on desktop */
  }

  .bulk-hero-m__media {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .bulk-hero-m__img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 16 / 10;
  }

  .bulk-hero-m__img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 30%,
      rgba(0,0,0,0.15) 70%,
      rgba(0,0,0,0.45) 100%
    );
    pointer-events: none;
  }

  .bulk-hero-m__body {
    padding: 24px 20px 32px;
    text-align: center;
    background: var(--bulk-white);
  }

  .bulk-hero-m__kicker {
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--bulk-gold);
    margin: 0 0 12px 0;
  }

  .bulk-hero-m__title {
    font-size: 22px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.5px;
    color: var(--bulk-black);
    margin: 0 0 16px 0;
    text-transform: uppercase;
  }

  .bulk-hero-m__pills {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .bulk-hero-m__pills span {
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.8px;
    color: var(--bulk-text);
    background: var(--bulk-cream);
    padding: 6px 14px;
    border-radius: 20px;
    border: 1px solid var(--bulk-border);
  }

  .bulk-hero-m__moq {
    font-size: 12px;
    color: var(--bulk-text-muted);
    margin: 0 0 20px 0;
  }

  .bulk-hero-m__btns {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .bulk-hero-m__btns .bulk-btn {
    width: 100%;
    text-align: center;
    padding: 14px 20px;
  }

  /* ================================ */
  /* WHO WE WORK WITH                 */
  /* ================================ */
  .bulk-clients {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 40px;
  }

  .bulk-clients__item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    padding: 24px;
    border: 1px solid var(--bulk-border);
    transition: border-color 0.3s ease;
  }

  .bulk-clients__item:hover {
    border-color: var(--bulk-gold);
  }

  .bulk-clients__item strong {
    font-size: 15px;
    font-weight: 600;
    color: var(--bulk-black);
    display: block;
    margin-bottom: 4px;
  }

  .bulk-clients__item p {
    font-size: 13px;
    color: var(--bulk-text-muted);
    line-height: 1.4;
    margin: 0;
  }

  /* ================================ */
  /* PRODUCT CATEGORIES               */
  /* ================================ */
  .bulk-products {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .bulk-products__card {
    text-decoration: none;
