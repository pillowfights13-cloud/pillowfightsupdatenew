
<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Jost:wght@300;400;500&display=swap');

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Jost', sans-serif;
    font-weight: 300;
    background: #ffffff;
    color: #1c1c1c;
    -webkit-font-smoothing: antialiased;
  }

  .pf-wrap {
    max-width: 640px;
    margin: 0 auto;
    padding: 48px 24px 64px;
  }

  /* ---- SCREEN VISIBILITY ---- */
  .screen { display: none; }
  .screen.active { display: block; }

  /* ---- PROGRESS ---- */
  .prog-track {
    width: 100%;
    height: 1px;
    background: #e8e8e0;
    margin-bottom: 48px;
  }
  .prog-fill {
    height: 1px;
    background: #1c1c1c;
    transition: width 0.5s ease;
  }

  /* ---- STEP LABEL ---- */
  .step-eyebrow {
    font-family: 'Jost', sans-serif;
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #999;
    margin-bottom: 16px;
  }

  /* ---- QUESTION ---- */
  .q-heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: 30px;
    font-weight: 300;
    line-height: 1.3;
    color: #1c1c1c;
    margin-bottom: 8px;
    letter-spacing: 0.01em;
  }
  .q-sub {
    font-size: 13px;
    font-weight: 300;
    color: #888;
    margin-bottom: 36px;
    line-height: 1.6;
  }

  /* ---- OPTIONS ---- */
  .opts { display: flex; flex-direction: column; gap: 1px; background: #e8e8e0; border: 1px solid #e8e8e0; }
  .opt {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 18px 20px;
    background: #fff;
    cursor: pointer;
    transition: background 0.15s;
    position: relative;
  }
  .opt:hover { background: #fafaf8; }
  .opt.selected { background: #f5f5f0; }
  .opt.selected::after {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 2px;
    background: #1c1c1c;
  }
  .opt-num {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: #bbb;
    min-width: 20px;
    font-family: 'Jost', sans-serif;
  }
  .opt.selected .opt-num { color: #1c1c1c; }
  .opt-body { flex: 1; }
  .opt-title {
    font-size: 14px;
    font-weight: 400;
    color: #1c1c1c;
    margin-bottom: 2px;
    letter-spacing: 0.02em;
  }
  .opt-hint {
    font-size: 12px;
    font-weight: 300;
    color: #aaa;
    letter-spacing: 0.01em;
  }
  .opt-check {
    width: 16px; height: 16px;
    border: 1px solid #ddd;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: all 0.15s;
  }
  .opt.selected .opt-check {
    background: #1c1c1c;
    border-color: #1c1c1c;
  }
  .opt-check-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #fff;
    display: none;
  }
  .opt.selected .opt-check-dot { display: block; }

  /* ---- NAV ---- */
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 40px;
    gap: 12px;
  }
  .btn-back {
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #999;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: color 0.15s;
  }
  .btn-back:hover { color: #1c1c1c; }
  .btn-back:disabled { opacity: 0.2; cursor: default; pointer-events: none; }

  .btn-next {
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    background: #1c1c1c;
    color: #fff;
    border: 1px solid #1c1c1c;
    padding: 14px 36px;
    cursor: pointer;
    transition: all 0.15s;
  }
  .btn-next:hover { background: #333; }
  .btn-next:disabled { opacity: 0.25; cursor: default; pointer-events: none; }

  /* ---- WELCOME SCREEN ---- */
  .welcome-label {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #999;
    margin-bottom: 20px;
  }
  .welcome-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 42px;
    font-weight: 300;
    line-height: 1.15;
    color: #1c1c1c;
    margin-bottom: 16px;
    letter-spacing: 0.01em;
  }
  .welcome-title em { font-style: italic; }
  .welcome-sub {
    font-size: 14px;
    font-weight: 300;
    color: #888;
    line-height: 1.8;
    margin-bottom: 40px;
    max-width: 440px;
  }
  .divider {
    width: 40px;
    height: 1px;
    background: #1c1c1c;
    margin-bottom: 40px;
  }

  /* ---- RESULT SCREEN ---- */
  .result-eyebrow {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #999;
    margin-bottom: 20px;
  }
  .result-heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: 36px;
    font-weight: 300;
    color: #1c1c1c;
    margin-bottom: 8px;
    letter-spacing: 0.01em;
  }
  .result-desc {
    font-size: 13px;
    font-weight: 300;
    color: #888;
    line-height: 1.8;
    margin-bottom: 40px;
  }
  .result-divider {
    width: 100%;
    height: 1px;
    background: #e8e8e0;
    margin-bottom: 40px;
  }

  /* ---- PRODUCT GRID ---- */
  .prod-section-label {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #999;
    margin-bottom: 20px;
  }
  .prod-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-bottom: 40px;
  }
  .prod-card {
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    display: block;
  }
  .prod-card:hover .prod-img { transform: scale(1.02); }
  .prod-img-wrap {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: #f5f5f0;
    margin-bottom: 12px;
  }
  .prod-img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .prod-badge {
    font-size: 9px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 5px;
  }
  .top-match .prod-badge { color: #1c1c1c; }
  .prod-name {
    font-size: 12px;
    font-weight: 400;
    color: #1c1c1c;
    line-height: 1.45;
    margin-bottom: 5px;
    letter-spacing: 0.01em;
  }
  .prod-price {
    font-size: 12px;
    font-weight: 300;
    color: #aaa;
    letter-spacing: 0.02em;
  }

  /* ---- ALSO EXPLORE ---- */
  .also-section { margin-bottom: 40px; }
  .also-label {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #999;
    margin-bottom: 16px;
  }
  .also-grid { display: flex; flex-direction: column; gap: 1px; background: #e8e8e0; border: 1px solid #e8e8e0; }
  .also-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    background: #fff;
    cursor: pointer;
    transition: background 0.15s;
    text-decoration: none;
    color: inherit;
  }
  .also-row:hover { background: #fafaf8; }
  .also-name {
    font-size: 13px;
    font-weight: 400;
    color: #1c1c1c;
    letter-spacing: 0.02em;
  }
  .also-arrow {
    font-size: 12px;
    color: #bbb;
  }

  /* ---- RESTART ---- */
  .restart-btn {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #bbb;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s;
  }
  .restart-btn:hover { color: #1c1c1c; }

  /* ---- VIEW ALL BTN ---- */
  .view-all-btn {
    display: inline-block;
    font-family: 'Jost', sans-serif;
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    background: #fff;
    color: #1c1c1c;
    border: 1px solid #1c1c1c;
    padding: 14px 32px;
    cursor: pointer;
    transition: all 0.15s;
    text-decoration: none;
    margin-bottom: 24px;
  }
  .view-all-btn:hover { background: #1c1c1c; color: #fff; }

  .btn-row { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
</style>
</head>
<body>
<div class="pf-wrap">

  <!-- WELCOME -->
  <div class="screen active" id="sc-welcome">
    <div class="welcome-label">Pillow Fights — Wall Art Finder</div>
    <div class="welcome-title">Find the art <em>you</em><br>were meant to own.</div>
    <div class="divider"></div>
    <div class="welcome-sub">Answer five questions about your space, your taste, and your mood. We'll match you with paintings from our collection that feel like they were made for your walls.</div>
    <button class="btn-next" onclick="startQuiz()">Begin &rarr;</button>
  </div>

  <!-- QUIZ -->
  <div class="screen" id="sc-quiz">
    <div class="prog-track"><div class="prog-fill" id="prog-fill"></div></div>
    <div class="step-eyebrow" id="eyebrow">Question 1 of 5</div>
    <div class="q-heading" id="q-heading"></div>
    <div class="q-sub" id="q-sub"></div>
    <div class="opts" id="opts-wrap"></div>
    <div class="nav">
      <button class="btn-back" id="btn-back" onclick="goBack()">&#8592; Back</button>
      <button class="btn-next" id="btn-next" onclick="goNext()" disabled>Next &rarr;</button>
    </div>
  </div>

  <!-- RESULT -->
  <div class="screen" id="sc-result">
    <div class="result-eyebrow">Your perfect match</div>
    <div class="result-heading" id="res-heading"></div>
    <div class="result-desc" id="res-desc"></div>
    <div class="result-divider"></div>
    <div class="prod-section-label">Recommended paintings</div>
    <div class="prod-grid" id="prod-grid"></div>
    <div class="btn-row">
      <a class="view-all-btn" id="view-all-link" href="#" target="_blank">View full collection &rarr;</a>
    </div>
    <div class="result-divider"></div>
    <div class="also-section">
      <div class="also-label">You might also like</div>
      <div class="also-grid" id="also-grid"></div>
    </div>
    <button class="restart-btn" onclick="resetQuiz()">Start over</button>
  </div>

</div>

