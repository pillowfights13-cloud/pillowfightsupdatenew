      { name: 'Street Map Art I', url: 'https://pillowfights.co.in/collections/street-maps', img: 'https://pillowfights.co.in/cdn/shop/files/05.webp?v=1774969933&width=600', price: 'From ₹1,699', tags: ['maps','urban','neutral','office'] },
      { name: 'Street Map Art II', url: 'https://pillowfights.co.in/collections/street-maps', img: 'https://pillowfights.co.in/cdn/shop/files/02.webp?v=1774969934&width=600', price: 'From ₹1,699', tags: ['maps','modern','cool','living'] },
      { name: 'Street Map Art III', url: 'https://pillowfights.co.in/collections/street-maps', img: 'https://pillowfights.co.in/cdn/shop/files/GrandBoulevardCityscape-CityWallArt_1.jpg?v=1773263557&width=600', price: 'From ₹1,699', tags: ['maps','dark','office','bold'] }
    ]
  },
  'Travel Wall Art': {
    url: 'https://pillowfights.co.in/collections/travel-wall-art',
    tags: ['landscape','travel','nature','cool','warm','living','bedroom','office'],
    desc: 'For the wanderer at heart. These prints carry the spirit of far-off places into the rooms you live in every day.',
    products: [
      { name: 'Travel Art — Warm Destinations', url: 'https://pillowfights.co.in/collections/travel-wall-art', img: 'https://pillowfights.co.in/cdn/shop/files/06.webp?v=1774969935&width=600', price: 'From ₹1,699', tags: ['travel','warm','earthy','living'] },
      { name: 'Travel Art — Landscapes', url: 'https://pillowfights.co.in/collections/travel-wall-art', img: 'https://pillowfights.co.in/cdn/shop/files/03.webp?v=1774969935&width=600', price: 'From ₹1,699', tags: ['travel','cool','landscape','bedroom','office'] },
      { name: 'Travel Art — Nature Series', url: 'https://pillowfights.co.in/collections/travel-wall-art', img: 'https://pillowfights.co.in/cdn/shop/files/04.webp?v=1774969934&width=600', price: 'From ₹1,699', tags: ['travel','nature','calm','bedroom'] }
    ]
  }
};

let cur = 0, answers = {};

function show(id) {
  document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
  document.getElementById(id).classList.add('active');
}

function startQuiz() { show('sc-quiz'); cur = 0; renderQ(); }

function renderQ() {
  const q = Q[cur];
  document.getElementById('eyebrow').textContent = 'Question ' + (cur + 1) + ' of ' + Q.length;
  document.getElementById('prog-fill').style.width = ((cur / Q.length) * 100) + '%';
  document.getElementById('q-heading').textContent = q.heading;
  document.getElementById('q-sub').textContent = q.sub;

  const wrap = document.getElementById('opts-wrap');
  wrap.innerHTML = '';
  q.opts.forEach((o, i) => {
    const d = document.createElement('div');
    d.className = 'opt' + (answers[q.id] === o.val ? ' selected' : '');
    d.innerHTML =
      '<span class="opt-num">0' + (i + 1) + '</span>' +
      '<div class="opt-body"><div class="opt-title">' + o.label + '</div><div class="opt-hint">' + o.hint + '</div></div>' +
      '<div class="opt-check"><div class="opt-check-dot"></div></div>';
    d.onclick = () => {
      answers[q.id] = o.val;
      wrap.querySelectorAll('.opt').forEach(x => x.classList.remove('selected'));
      d.classList.add('selected');
      document.getElementById('btn-next').disabled = false;
    };
    wrap.appendChild(d);
  });

  document.getElementById('btn-back').disabled = cur === 0;
  document.getElementById('btn-next').disabled = !answers[q.id];
  const isLast = cur === Q.length - 1;
  document.getElementById('btn-next').textContent = isLast ? 'See my paintings →' : 'Next →';
}

function goNext() {
  if (!answers[Q[cur].id]) return;
  if (cur < Q.length - 1) { cur++; renderQ(); }
  else showResult();
}

function goBack() {
  if (cur > 0) { cur--; renderQ(); }
}

function scoreCollections() {
  const a = answers;
  const signals = Object.values(a).filter(Boolean);
  const scores = {};
  Object.keys(COLS).forEach(k => scores[k] = 0);

  Object.entries(COLS).forEach(([name, col]) => {
    signals.forEach(sig => { if (col.tags.includes(sig)) scores[name] += 2; });
    col.products.forEach(p => {
      signals.forEach(sig => { if (p.tags.includes(sig)) scores[name] += 1; });
    });
  });

  // Hard boosts based on specific answers
  if (a.style === 'abstract')  { scores['Abstract Art'] += 5; }
  if (a.style === 'boho')      { scores['Boho Art'] += 5; }
  if (a.style === 'urban')     { scores['City Art'] += 4; scores['Street Maps'] += 3; }
  if (a.style === 'nature')    { scores['Botanical'] += 3; scores['Landscape Art'] += 3; scores['Travel Wall Art'] += 1; }
  if (a.subject === 'botanical') { scores['Botanical'] += 6; }
  if (a.subject === 'maps')    { scores['Street Maps'] += 5; scores['City Art'] += 2; }
  if (a.subject === 'landscape') { scores['Landscape Art'] += 5; scores['Travel Wall Art'] += 3; }
  if (a.subject === 'food')    { scores['Food and Bar Art'] += 7; }
  if (a.room === 'dining')     { scores['Food and Bar Art'] += 3; scores['Botanical'] += 1; }
  if (a.room === 'office')     { scores['Street Maps'] += 2; scores['City Art'] += 2; scores['Abstract Art'] += 1; }
  if (a.mood === 'bold')       { scores['Abstract Art'] += 2; scores['City Art'] += 2; }
  if (a.mood === 'calm')       { scores['Botanical'] += 2; scores['Landscape Art'] += 2; }
  if (a.mood === 'earthy')     { scores['Boho Art'] += 2; scores['Botanical'] += 1; }
  if (a.palette === 'warm')    { scores['Boho Art'] += 2; scores['Botanical'] += 1; scores['Food and Bar Art'] += 1; }
  if (a.palette === 'dark')    { scores['City Art'] += 2; scores['Abstract Art'] += 2; }
  if (a.palette === 'cool')    { scores['Landscape Art'] += 1; scores['Street Maps'] += 1; }

  return Object.entries(scores).sort((a, b) => b[1] - a[1]);
}

function showResult() {
  const ranked = scoreCollections();
  const topKey = ranked[0][0];
  const top = COLS[topKey];
  const alts = ranked.slice(1, 4).map(x => x[0]);

  document.getElementById('res-heading').textContent = topKey;
  document.getElementById('res-desc').textContent = top.desc;
  document.getElementById('view-all-link').href = top.url;

  const grid = document.getElementById('prod-grid');
  grid.innerHTML = '';
  top.products.slice(0, 3).forEach((p, i) => {
    const a = document.createElement('a');
    a.href = p.url;
    a.target = '_blank';
    a.className = 'prod-card' + (i === 0 ? ' top-match' : '');
    a.innerHTML =
      '<div class="prod-img-wrap"><img class="prod-img" src="' + p.img + '" alt="' + p.name + '" loading="lazy"></div>' +
      '<div class="prod-badge">' + (i === 0 ? 'Best match' : 'Also consider') + '</div>' +
      '<div class="prod-name">' + p.name + '</div>' +
      '<div class="prod-price">' + p.price + '</div>';
    grid.appendChild(a);
  });

  const ag = document.getElementById('also-grid');
  ag.innerHTML = '';
  alts.forEach(k => {
    const row = document.createElement('a');
    row.href = COLS[k].url;
    row.target = '_blank';
    row.className = 'also-row';
    row.innerHTML = '<span class="also-name">' + k + '</span><span class="also-arrow">&#8594;</span>';
    ag.appendChild(row);
  });

  show('sc-result');
}

function resetQuiz() {
  cur = 0; answers = {};
  show('sc-welcome');
}
</script>
