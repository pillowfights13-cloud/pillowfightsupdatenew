<section class="shop-by-category">
  <div class="container">
    <h2 class="heading">Shop by Category</h2>
    
    <!-- Desktop Grid -->
    <div class="categories-grid desktop-only">
      {% for block in section.blocks %}
        <div class="category-item">
          <a href="{{ block.settings.link }}" class="category-link">
            <div class="category-image">
              <img src="{{ block.settings.image | image_url: width: 400, height: 400 }}" alt="{{ block.settings.alt_text }}" width="400" height="400">
              <div class="category-overlay">
                <h3 class="category-title">{{ block.settings.title }}</h3>
                {% if block.settings.subtitle != blank %}
                  <p class="category-subtitle">{{ block.settings.subtitle }}</p>
                {% endif %}
              </div>
            </div>
          </a>
        </div>
      {% endfor %}
    </div>
    
    <!-- Mobile Swiper -->
    <div class="categories-swiper mobile-only">
      <div class="swiper mySwiper">
        <div class="swiper-wrapper">
          {% for block in section.blocks %}
            <div class="swiper-slide category-item">
              <a href="{{ block.settings.link }}" class="category-link">
                <div class="category-image">
                  <img src="{{ block.settings.image | image_url: width: 600, height: 600 }}" alt="{{ block.settings.alt_text }}" width="600" height="600">
                  <div class="category-overlay">
                    <h3 class="category-title">{{ block.settings.title }}</h3>
                    {% if block.settings.subtitle != blank %}
                      <p class="category-subtitle">{{ block.settings.subtitle }}</p>
                    {% endif %}
                  </div>
                </div>
              </a>
            </div>
          {% endfor %}
        </div>
        <div class="swiper-pagination"></div>
      </div>
    </div>

  </div>
</section>

<!-- Swiper CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"/>

<!-- Swiper JS -->
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>

<style>
.shop-by-category {
  text-align: center;
  padding: 50px 20px;
  max-width: 1400px;
  margin: auto;
  overflow: hidden;
  position: relative;
}

.shop-by-category .heading {
  font-size: 32px;
  margin-bottom: 30px;
  font-weight: 400;
}

/* Desktop Styles */
.categories-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 15px;
  margin: 0 auto;
}

/* Common Category Styles */
.category-item {
  text-align: center;
}

.category-link {
  display: block;
  text-decoration: none;
}

.category-image {
  position: relative;
  width: 100%;
  aspect-ratio: 1 / 1;
  overflow: hidden;
  border-radius: 4px;
}

.category-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.5s ease;
}

.category-link:hover .category-image img {
  transform: scale(1.05);
}

.category-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20px;
  text-align: left;
  background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 100%);
  color: #fff;
}

.category-title {
  margin: 0;
  font-size: 18px;
  font-weight: 500;
  color: #fff;
  text-transform: none;
  letter-spacing: 0.5px;
}

.category-subtitle {
  margin: 4px 0 0;
  font-size: 11px;
  font-weight: 400;
  color: #fff;
  text-transform: uppercase;
  letter-spacing: 1px;
  opacity: 0.9;
}

/* Mobile Swiper Styles */
.categories-swiper {
  width: 100%;
  padding-bottom: 35px !important;
}

.categories-swiper .swiper {
  width: 100%;
  padding-bottom: 30px;
}

.categories-swiper .swiper-slide {
  height: auto;
}

.swiper-pagination {
  bottom: 0px;
}

.swiper-pagination-bullet {
  background-color: #ddd;
  width: 10px;
  height: 10px;
  opacity: 1;
  margin: 0 5px;
}

.swiper-pagination-bullet-active {
  background-color: #8d7045;
}

/* Responsive Display */
@media screen and (min-width: 769px) {
  .desktop-only {
    display: grid;
  }
  .mobile-only {
    display: none;
  }
}

@media screen and (max-width: 768px) {
  .desktop-only {
    display: none;
  }
  .mobile-only {
    display: block;
  }

  .shop-by-category {
    padding: 30px 15px;
  }

  .shop-by-category .heading {
    font-size: 22px;
    margin-bottom: 20px;
  }

  .category-overlay {
    padding: 12px;
  }

  .category-title {
    font-size: 15px;
  }

  .category-subtitle {
    font-size: 10px;
  }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function () {
  if (window.innerWidth <= 768) {
    new Swiper('.mySwiper', {
      slidesPerView: 1.5,
      spaceBetween: 12,
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      breakpoints: {
        480: {
          slidesPerView: 2.2,
          spaceBetween: 15,
        }
      }
    });
  }
});
</script>

{% schema %}
{
  "name": "Shop by Category",
  "settings": [],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text",
          "default": "Category image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category",
      "category": "Custom"
    }
  ]
}
{% endschema %}