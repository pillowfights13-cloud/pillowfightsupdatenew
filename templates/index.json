=\"24\" cy=\"24\" r=\"16\"\/>\n            <path d=\"M24 8 C18 16 18 32 24 40 C30 32 30 16 24 8\"\/>\n            <path d=\"M8 24 L40 24\"\/>\n            <path d=\"M11 16 L37 16 M11 32 L37 32\"\/>\n            <circle cx=\"24\" cy=\"24\" r=\"2\" fill=\"currentColor\"\/>\n          <\/svg>\n        <\/div>\n        <div class=\"usp-content\">\n          <span class=\"usp-tag\">03 — Delivery<\/span>\n          <h3 class=\"usp-heading\">Ship Pan-India<\/h3>\n          <p class=\"usp-body\">Safely packaged and delivered to your doorstep across every corner of India.<\/p>\n        <\/div>\n        <div class=\"usp-corner usp-corner-tl\"><\/div>\n        <div class=\"usp-corner usp-corner-br\"><\/div>\n      <\/div>\n    <\/div>\n\n    <div class=\"usp-card\" style=\"--delay: 0.3s;\">\n      <div class=\"usp-card-inner\">\n        <div class=\"usp-icon-wrap\">\n          <div class=\"usp-icon-bg\"><\/div>\n          <svg class=\"usp-icon\" viewBox=\"0 0 48 48\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <rect x=\"8\" y=\"18\" width=\"32\" height=\"22\" rx=\"1\"\/>\n            <path d=\"M6 18 L42 18 L42 24 L6 24 Z\" fill=\"currentColor\" fill-opacity=\"0.08\"\/>\n            <path d=\"M24 18 L24 40\"\/>\n            <path d=\"M24 18 C20 14 14 14 14 10 C14 8 16 6 18 6 C22 6 24 12 24 18\"\/>\n            <path d=\"M24 18 C28 14 34 14 34 10 C34 8 32 6 30 6 C26 6 24 12 24 18\"\/>\n          <\/svg>\n        <\/div>\n        <div class=\"usp-content\">\n          <span class=\"usp-tag\">04 — Gifting<\/span>\n          <h3 class=\"usp-heading\">Gift-Ready Always<\/h3>\n          <p class=\"usp-body\">Thoughtful pieces that make perfect Diwali, wedding & housewarming gifts.<\/p>\n        <\/div>\n        <div class=\"usp-corner usp-corner-tl\"><\/div>\n        <div class=\"usp-corner usp-corner-br\"><\/div>\n      <\/div>\n    <\/div>\n\n  <\/div>\n<\/section>\n\n<style>\n.usp-showcase {\n  background: linear-gradient(180deg, #faf5ec 0%, #f5ede0 100%);\n  padding: 70px 24px;\n  position: relative;\n  overflow: hidden;\n}\n\n.usp-showcase::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 50%;\n  transform: translateX(-50%);\n  width: 80%;\n  height: 1px;\n  background: linear-gradient(90deg, transparent 0%, rgba(141, 112, 69, 0.3) 50%, transparent 100%);\n}\n\n.usp-showcase::after {\n  content: \"\";\n  position: absolute;\n  bottom: 0;\n  left: 50%;\n  transform: translateX(-50%);\n  width: 80%;\n  height: 1px;\n  background: linear-gradient(90deg, transparent 0%, rgba(141, 112, 69, 0.3) 50%, transparent 100%);\n}\n\n.usp-wrapper {\n  max-width: 1400px;\n  margin: 0 auto;\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 24px;\n}\n\n.usp-card {\n  position: relative;\n  opacity: 0;\n  transform: translateY(20px);\n  animation: uspFadeUp 0.7s ease-out forwards;\n  animation-delay: var(--delay);\n}\n\n@keyframes uspFadeUp {\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n.usp-card-inner {\n  position: relative;\n  background: #fffaf0;\n  padding: 32px 26px 30px;\n  height: 100%;\n  border: 1px solid rgba(141, 112, 69, 0.12);\n  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);\n  overflow: hidden;\n}\n\n.usp-card-inner::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 2px;\n  background: linear-gradient(90deg, #8d7045 0%, #b8945c 50%, #8d7045 100%);\n  transform: scaleX(0);\n  transform-origin: left;\n  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n.usp-card:hover .usp-card-inner {\n  transform: translateY(-6px);\n  box-shadow: 0 20px 40px -15px rgba(141, 112, 69, 0.25);\n  border-color: rgba(141, 112, 69, 0.25);\n}\n\n.usp-card:hover .usp-card-inner::before {\n  transform: scaleX(1);\n}\n\n.usp-corner {\n  position: absolute;\n  width: 14px;\n  height: 14px;\n  border-color: #8d7045;\n  transition: all 0.4s ease;\n}\n\n.usp-corner-tl {\n  top: 8px;\n  left: 8px;\n  border-top: 1px solid;\n  border-left: 1px solid;\n}\n\n.usp-corner-br {\n  bottom: 8px;\n  right: 8px;\n  border-bottom: 1px solid;\n  border-right: 1px solid;\n}\n\n.usp-card:hover .usp-corner {\n  width: 20px;\n  height: 20px;\n}\n\n.usp-icon-wrap {\n  position: relative;\n  width: 64px;\n  height: 64px;\n  margin-bottom: 24px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.usp-icon-bg {\n  position: absolute;\n  inset: 0;\n  background: #f5ede0;\n  border-radius: 50%;\n  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n.usp-card:hover .usp-icon-bg {\n  transform: scale(1.15);\n  background: #ebe0cc;\n}\n\n.usp-icon {\n  position: relative;\n  width: 36px;\n  height: 36px;\n  color: #6b5536;\n  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);\n  z-index: 1;\n}\n\n.usp-card:hover .usp-icon {\n  transform: scale(1.08) rotate(-3deg);\n  color: #8d7045;\n}\n\n.usp-content {\n  position: relative;\n}\n\n.usp-tag {\n  display: inline-block;\n  font-size: 10px;\n  font-weight: 500;\n  color: #8d7045;\n  text-transform: uppercase;\n  letter-spacing: 2px;\n  margin-bottom: 10px;\n}\n\n.usp-heading {\n  margin: 0 0 10px;\n  font-size: 17px;\n  font-weight: 500;\n  color: #2c2418;\n  letter-spacing: 0.2px;\n  line-height: 1.3;\n}\n\n.usp-body {\n  margin: 0;\n  font-size: 13px;\n  color: #6b5d48;\n  line-height: 1.55;\n  font-weight: 400;\n}\n\n\/* Tablet *\/\n@media screen and (max-width: 1024px) and (min-width: 769px) {\n  .usp-wrapper {\n    grid-template-columns: repeat(2, 1fr);\n    gap: 20px;\n  }\n}\n\n\/* Mobile slider *\/\n@media screen and (max-width: 768px) {\n  .usp-showcase {\n    padding: 50px 0;\n  }\n\n  .usp-wrapper {\n    display: flex;\n    grid-template-columns: none;\n    gap: 16px;\n    overflow-x: auto;\n    scroll-snap-type: x mandatory;\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none;\n    padding: 8px 24px 24px;\n    scroll-padding: 24px;\n  }\n\n