r-radius: 999px;\n}\n\n.pf-rating-icon svg {\n  display: block;\n}\n\n.pf-rating-value {\n  font-weight: 700; /* bold rating number */\n  color: #000000;\n}\n\n.pf-rating-count {\n  font-weight: 500;\n  color: #333333;\n}\n\n/* small screens tweak if needed */\n@media (max-width: 480px) {\n  .pf-rating-wrapper {\n    font-size: 13px;\n  }\n}\n\n</style>"
