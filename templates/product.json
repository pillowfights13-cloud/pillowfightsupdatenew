        "liquid_fq9UnR": {
          "type": "liquid",
          "name": "Offer variable",
          "disabled": true,
          "settings": {
            "liquid": "{%- comment -%}\n============================================================\nPILLOW FIGHTS — TIERED OFFER COMPONENT\n============================================================\nFile: snippets/pf-offers.liquid\n\nUSAGE:\n  In your product template (sections/main-product.liquid or\n  templates/product.liquid), add this line right below the\n  \"Add to Cart / Buy Now\" block:\n\n    {% render 'pf-offers', product: product %}\n\nCONFIG (edit the TIER values below to change thresholds):\n  Tier 1: Free Shipping     → ₹1,000\n  Tier 2: Free Gift         → ₹3,000\n  Tier 3: Flat 10% Off      → ₹7,000\n\nShopify prices are stored in paise (1 INR = 100 paise),\nso ₹1,000 = 100000 in Liquid.\n============================================================\n{%- endcomment -%}\n\n{%- liquid\n  assign tier1_threshold = 100000\n  assign tier2_threshold = 300000\n  assign tier3_threshold = 700000\n  assign tier3_discount_pct = 10\n\n  assign cart_total = cart.total_price | default: 0\n  assign product_price = product.selected_or_first_available_variant.price | default: 0\n\n  assign effective_total = cart_total\n  if cart_total == 0\n    assign effective_total = product_price\n  endif\n-%}\n\n<div\n  class=\"pf-offers\"\n  id=\"pfOffers\"\n  data-cart-total=\"{{ cart_total }}\"\n  data-product-price=\"{{ product_price }}\"\n  data-tier1=\"{{ tier1_threshold }}\"\n  data-tier2=\"{{ tier2_threshold }}\"\n  data-tier3=\"{{ tier3_threshold }}\"\n  data-discount-pct=\"{{ tier3_discount_pct }}\"\n>\n  {%- comment -%} Rendered by JavaScript below {%- endcomment -%}\n</div>\n\n<style>\n  .pf-offers {\n    background: #F5F1EA;\n    border-radius: 16px;\n    padding: 14px;\n    margin: 16px 0;\n    font-family: inherit;\n  }\n  .pf-offers-header {\n    display: flex;\n    align-items: center;\n    gap: 8px;\n    margin-bottom: 12px;\n    padding: 0 4px;\n  }\n  .pf-offers-title {\n    font-size: 12px;\n    font-weight: 500;\n    letter-spacing: 1.5px;\n    color: #1C1C1A;\n    text-transform: uppercase;\n  }\n  .pf-tiers {\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n  }\n  .pf-tier {\n    background: #FFFFFF;\n    border-radius: 12px;\n    padding: 14px 16px;\n    border: 0.5px solid rgba(0, 0, 0, 0.08);\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    position: relative;\n    transition: all 0.25s ease;\n  }\n  .pf-tier.is-next {\n    border: 1.5px solid #B87333;\n    box-shadow: 0 2px 8px rgba(184, 115, 51, 0.08);\n  }\n  .pf-tier.is-unlocked {\n    background: #F4F7F0;\n    border-color: #C0DD97;\n  }\n  .pf-tier-badge {\n    position: absolute;\n    top: -8px;\n    right: 12px;\n    background: #B87333;\n    color: #FFFFFF;\n    font-size: 9px;\n    font-weight: 500;\n    letter-spacing: 1px;\n    padding: 3px 8px;\n    border-radius: 4px;\n    text-transform: uppercase;\n  }\n  .pf-tier-badge.unlocked { background: #5E8A2F; }\n  .pf-tier-left {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    flex: 1;\n    min-width: 0;\n  }\n  .pf-tier-icon {\n    width: 36px;\n    height: 36px;\n    border-radius: 50%;\n    background: #F5F1EA;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n  }\n  .pf-tier.is-next .pf-tier-icon { background: #FFF4E4; }\n  .pf-tier.is-unlocked .pf-tier-icon { background: #EAF3DE; }\n  .pf-tier-title {\n    font-size: 14px;\n    font-weight: 500;\n    color: #1C1C1A;\n    line-height: 1.3;\n  }\n  .pf-tier-sub {\n    font-size: 11px;\n    color: #6E6A5F;\n    margin-top: 2px;\n  }\n  .pf-tier-sub.unlocked-text {\n    color: #5E8A2F;\n    font-weight: 500;\n  }\n  .pf-tier-right {\n    text-align: right;\n    flex-shrink: 0;\n    margin-left: 10px;\n  }\n  .pf-tier-right .label { font-size: 11px; color: #8A8578; }\n  .pf-tier-right .amount {\n    font-size: 13px;\n    font-weight: 500;\n    color: #5F5E5A;\n  }\n  .pf-tier.is-next .pf-tier-right .amount { color: #B87333; }\n  .pf-tier-right .check {\n    width: 24px;\n    height: 24px;\n    border-radius: 50%;\n    background: #5E8A2F;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .pf-savings-summary {\n    margin-top: 12px;\n    padding: 10px 14px;\n    background: #FFF9F0;\n    border: 1px solid #F0E4D0;\n    border-radius: 10px;\n    text-align: center;\n  }\n  .pf-savings-summary .line {\n    font-size: 12px;\n    color: #5A4A30;\n    line-height: 1.5;\n  }\n  .pf-savings-summary .accent { font-weight: 500; color: #B87333; }\n  .pf-savings-summary .green { font-weight: 500; color: #5E8A2F; }\n  .pf-savings-summary .payable {\n    color: #1C1C1A;\n    font-size: 13px;\n    font-weight: 500;\n  }\n  .pf-footer-note {\n    margin-top: 10px;\n    text-align: center;\n    font-size: 11px;\n    color: #8A8578;\n    letter-spacing: 0.3px;\n  }\n</style>\n\n<script>\n(function() {\n  'use strict';\n\n  const TIERS_CONFIG = [\n    {\n      id: 'shipping',\n      title: 'Free Shipping',\n      sub: 'Spend {threshold} or more',\n      unlockedText: 'Free shipping unlocked',\n      icon: 'truck'\n    },\n    {\n      id: 'gift',\n      title: 'Free Paw Print Coaster',\n      sub: 'Spend {threshold} or more',\n      unlockedText: 'Free gift added to your cart',\n      icon: 'gift'\n    },\n    {\n      id: 'discount',\n      title: 'Flat 10% Off Entire Cart',\n      sub: 'Spend {threshold} or more',\n      unlockedText: '10% off will be applied',\n      icon: 'percent'\n    }\n  ];\n\n  const ICONS = {\n    truck: '<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M3 7h11v10H3zM14 10h4l3 3v4h-7\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\" fill=\"none\"/><circle cx=\"7\" cy=\"18\" r=\"1.8\" stroke=\"currentColor\" stroke-width=\"1.5\" fill=\"none\"/><circle cx=\"17\" cy=\"18\" r=\"1.8\" stroke=\"currentColor\" stroke-width=\"1.5\" fill=\"none\"/></svg>',\n    gift: '<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\"><rect x=\"3\" y=\"8\" width=\"18\" height=\"4\" stroke=\"currentColor\" stroke-width=\"1.5\" fill=\"none\"/><path d=\"M5 12v9h14v-9M12 21V8M12 8H7.5a2.5 2.5 0 010-5C11 3 12 8 12 8zM12 8h4.5a2.5 2.5 0 000-5C13 3 12 8 12 8z\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\" fill=\"none\"/></svg>',\n    percent: '<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M8 16l8-8\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/><circle cx=\"8.5\" cy=\"8.5\" r=\"1.5\" stroke=\"currentColor\" stroke-width=\"1.5\" fill=\"none\"/><circle cx=\"15.5\" cy=\"15.5\" r=\"1.5\" stroke=\"currentColor\" stroke-width=\"1.5\" fill=\"none\"/></svg>',\n    check: '<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M5 12l5 5L20 7\" stroke=\"white\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>',\n    sparkle: '<svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 2l2 7 7 2-7 2-2 7-2-7-7-2 7-2 2-7z\" stroke=\"#B87333\" stroke-width=\"1.4\" stroke-linejoin=\"round\" fill=\"none\"/></svg>'\n  };\n\n  // Shopify stores prices in paise (subunits). Convert to rupees for display.\n  const fmt = (paise) => '₹' + Math.round(paise / 100).toLocaleString('en-IN');\n\n  function render() {\n    const container = document.getElementById('pfOffers');\n    if (!container) return;\n\n    const cartTotal = parseInt(container.dataset.cartTotal) || 0;\n    const productPrice = parseInt(container.dataset.productPrice) || 0;\n    const discountPct = parseInt(container.dataset.discountPct) || 10;\n\n    const thresholds = [\n      parseInt(container.dataset.tier1),\n      parseInt(container.dataset.tier2),\n      parseInt(container.dataset.tier3)\n    ];\n\n    // KEY LOGIC:\n    // If cart is empty, use the product price as the reference so\n    // the shopper sees where adding THIS product would take them.\n    // If cart has items, use the actual cart total.\n    const referenceTotal = cartTotal > 0 ? cartTotal : productPrice;\n    const isCartEmpty = cartTotal === 0;\n\n    const tiers = TIERS_CONFIG.map((t, i) => ({\n      ...t,\n      threshold: thresholds[i]\n    }));\n\n    const nextTierIndex = tiers.findIndex(t => referenceTotal < t.threshold);\n\n    let html = `\n      <div class=\"pf-offers-header\">\n        ${ICONS.sparkle}\n        <span class=\"pf-offers-title\">Exclusive Rewards</span>\n      </div>\n      <div class=\"pf-tiers\">\n    `;\n\n    tiers.forEach((tier, idx) => {\n      const isUnlocked = referenceTotal >= tier.threshold;\n      const isNext = idx === nextTierIndex;\n      const amountNeeded = tier.threshold - referenceTotal;\n\n      let classes = 'pf-tier';\n      if (isUnlocked) classes += ' is-unlocked';\n      else if (isNext) classes += ' is-next';\n\n      let badge = '';\n      if (isNext) {\n        badge = '<div class=\"pf-tier-badge\">Closest to You</div>';\n      } else if (isUnlocked) {\n        badge = '<div class=\"pf-tier-badge unlocked\">Unlocked</div>';\n      }\n\n      let rightSide;\n      if (isUnlocked) {\n        rightSide = `<div class=\"pf-tier-right\"><span class=\"check\">${ICONS.check}</span></div>`;\n      } else {\n        rightSide = `\n          <div class=\"pf-tier-right\">\n            <div class=\"label\">Add</div>\n            <div class=\"amount\">${fmt(amountNeeded)}</div>\n          </div>\n        `;\n      }\n\n      const subText = isUnlocked\n        ? `<div class=\"pf-tier-sub unlocked-text\">${tier.unlockedText}</div>`\n        : `<div class=\"pf-tier-sub\">${tier.sub.replace('{threshold}', fmt(tier.threshold))}</div>`;\n\n      const iconColor = isNext ? '#B87333' : (isUnlocked ? '#5E8A2F' : '#5F5E5A');\n\n      html += `\n        <div class=\"${classes}\">\n          ${badge}\n          <div class=\"pf-tier-left\">\n            <div class=\"pf-tier-icon\" style=\"color: ${iconColor}\">\n              ${ICONS[tier.icon]}\n            </div>\n            <div style=\"min-width: 0; flex: 1;\">\n              <div class=\"pf-tier-title\">${tier.title}</div>\n              ${subText}\n            </div>\n          </div>\n          ${rightSide}\n        </div>\n      `;\n    });\n\n    html += '</div>';\n    html += renderSummary(referenceTotal, nextTierIndex, tiers, discountPct, isCartEmpty);\n    html += '<div class=\"pf-footer-note\">Rewards auto-apply at checkout · No code needed</div>';\n\n    container.innerHTML = html;\n  }\n\n  function renderSummary(refTotal, nextIdx, tiers, discountPct, isCartEmpty) {\n    // All tiers unlocked — show the 10% discount calculation\n    if (nextIdx === -1) {\n      const discount = Math.round(refTotal * (discountPct / 100));\n      const payable = refTotal - discount;\n      const prefix = isCartEmpty ? 'With this item, you' : 'You';\n      return `\n        <div class=\"pf-savings-summary\">\n          <div class=\"line\"><span class=\"green\">All rewards unlocked</span></div>\n          <div class=\"line\" style=\"margin-top: 4px;\">\n            ${prefix} save <span class=\"accent\">${fmt(discount)}</span> · Pay <span class=\"payable\">${fmt(payable)}</span>\n          </div>\n        </div>\n      `;\n    }\n\n    const nextTier = tiers[nextIdx];\n    const needed = nextTier.threshold - refTotal;\n    const prefix = isCartEmpty ? 'Add' : 'Add';\n\n    return `\n      <div class=\"pf-savings-summary\">\n        <div class=\"line\">\n          ${prefix} <span class=\"accent\">${fmt(needed)} more</span> to unlock <span class=\"accent\">${nextTier.title.toLowerCase()}</span>\n        </div>\n      </div>\n    `;\n  }\n\n  // Initial render on page load\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', render);\n  } else {\n    render();\n  }\n\n  // Re-render when cart updates (if your theme supports cart events)\n  document.addEventListener('cart:updated', function(e) {\n    const container = document.getElementById('pfOffers');\n    if (container && e.detail && typeof e.detail.total_price !== 'undefined') {\n      container.dataset.cartTotal = e.detail.total_price;\n      render();\n    }\n  });\n\n  // Optional: listen for variant changes to update product price reference\n  document.addEventListener('variant:change', function(e) {\n    const container = document.getElementById('pfOffers');\n    if (container && e.detail && typeof e.detail.price !== 'undefined') {\n      container.dataset.productPrice = e.detail.price;\n      render();\n    }\n  });\n\n})();\n</script>"
          }
        },
