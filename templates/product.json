            "liquid": "<style>\n  .fera-benefits-bar {\n    background: #fff;\n    border: 1px solid rgba(0,0,0,0.08);\n    border-radius: 6px;\n    padding: 1rem 1.25rem;\n    margin: 1.25rem 0;\n  }\n  .fera-benefits-bar__container {\n    display: flex;\n    align-items: center;\n    gap: 1.5rem;\n    max-width: 100%;\n  }\n  .fera-benefits-bar__items {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 0.875rem 1.5rem;\n    flex: 1;\n  }\n  .fera-benefits-bar__item {\n    display: flex;\n    align-items: center;\n    gap: 0.5rem;\n    white-space: nowrap;\n  }\n  .fera-benefits-bar__icon {\n    flex-shrink: 0;\n    width: 20px;\n    height: 20px;\n    color: rgba(0,0,0,0.65);\n    transition: color 0.2s ease;\n  }\n  .fera-benefits-bar__item:hover .fera-benefits-bar__icon { color: #000; }\n  .fera-benefits-bar__text {\n    font-size: 0.875rem;\n    font-weight: 400;\n    letter-spacing: 0.01em;\n    line-height: 1.3;\n    color: rgba(0,0,0,0.85);\n    transition: color 0.2s ease;\n  }\n  .fera-benefits-bar__item:hover .fera-benefits-bar__text { color: #000; }\n\n  @media (min-width: 1200px) {\n    .fera-benefits-bar { padding: 1rem 1.5rem; }\n    .fera-benefits-bar__items {\n      grid-template-columns: repeat(2, 2fr);\n      gap: 1rem 2rem;\n    }\n  }\n  @media (min-width: 769px) and (max-width: 1199px) {\n    .fera-benefits-bar__items { gap: 0.875rem 1.25rem; }\n  }\n  @media (max-width: 768px) {\n    .fera-benefits-bar {\n      padding: 0.875rem 1rem;\n      border-radius: 0;\n      border-left: none;\n      border-right: none;\n      margin: 1rem 0;\n    }\n    .fera-benefits-bar__items { gap: 0.75rem 1rem; }\n    .fera-benefits-bar__item { gap: 0.4rem; }\n    .fera-benefits-bar__icon { width: 18px; height: 18px; }\n    .fera-benefits-bar__text { font-size: 0.8125rem; }\n  }\n  @media (max-width: 480px) {\n    .fera-benefits-bar { padding: 0.75rem 1rem; }\n    .fera-benefits-bar__items { gap: 0.625rem 0.875rem; }\n    .fera-benefits-bar__icon { width: 16px; height: 16px; }\n    .fera-benefits-bar__text { font-size: 0.75rem; }\n  }\n  @media (prefers-reduced-motion: reduce) {\n    .fera-benefits-bar__icon,\n    .fera-benefits-bar__text { transition: none; }\n  }\n  @media (prefers-contrast: high) {\n    .fera-benefits-bar { border: 2px solid rgba(0,0,0,0.3); }\n    .fera-benefits-bar__icon,\n    .fera-benefits-bar__text { color: #000; }\n  }\n  </style>\n\n  <div class=\"fera-benefits-bar\" aria-label=\"Shipping & delivery benefits\">\n    <div class=\"fera-benefits-bar__container\">\n      <div class=\"fera-benefits-bar__items\">\n\n        <div class=\"fera-benefits-bar__item\">\n          <svg class=\"fera-benefits-bar__icon\" width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n            <circle cx=\"10\" cy=\"10\" r=\"8\" stroke=\"currentColor\" stroke-width=\"1.2\"/>\n            <path d=\"M10 6V10L12.5 11.5\" stroke=\"currentColor\" stroke-width=\"1.2\" stroke-linecap=\"round\"/>\n          </svg>\n          <span class=\"fera-benefits-bar__text\">Cash on Delivery</span>\n        </div>\n\n        <div class=\"fera-benefits-bar__item\">\n          <svg class=\"fera-benefits-bar__icon\" width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n            <path d=\"M13 2.5H16.5C16.7761 2.5 17 2.72386 17 3V16.5C17 16.7761 16.7761 17 16.5 17H3.5C3.22386 17 3 16.7761 3 16.5V3C3 2.72386 3.22386 2.5 3.5 2.5H7\" stroke=\"currentColor\" stroke-width=\"1.2\" stroke-linecap=\"round\" \n  stroke-linejoin=\"round\"/>\n            <path d=\"M6.5 7L9 9.5L13.5 5\" stroke=\"currentColor\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n          <span class=\"fera-benefits-bar__text\">Free delivery above ₹1,000</span>\n        </div>\n\n        <div class=\"fera-benefits-bar__item\">\n          <svg class=\"fera-benefits-bar__icon\" width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n            <path d=\"M2 7.5L10 3L18 7.5M2 7.5V16.5L10 12M2 7.5L10 12M18 7.5V16.5L10 12M18 7.5L10 12\" stroke=\"currentColor\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n          <span class=\"fera-benefits-bar__text\">3–5 day delivery</span>\n        </div>\n\n        <div class=\"fera-benefits-bar__item\">\n          <svg class=\"fera-benefits-bar__icon\" width=\"20\" height=\"20\" viewBox=\"0 0 20 20\" fill=\"none\" aria-hidden=\"true\">\n            <path d=\"M17 10C17 13.866 13.866 17 10 17C6.13401 17 3 13.866 3 10C3 6.13401 6.13401 3 10 3C13.866 3 17 6.13401 17 10Z\" stroke=\"currentColor\" stroke-width=\"1.2\"/>\n            <path d=\"M7 10L9 12L13 8\" stroke=\"currentColor\" stroke-width=\"1.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n          </svg>\n          <span class=\"fera-benefits-bar__text\">7-day easy returns</span>\n        </div>\n\n      </div>\n    </div>\n  </div>"
