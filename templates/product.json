            "liquid": "{% if product.metafields.custom.features.value %}\n  <style>\n    .pf-section-label {\n      font-size: 14px;\n      letter-spacing: 0.12em;\n      text-transform: uppercase;\n      color: #9a7a52;\n      font-weight: 600;\n      margin-bottom: 10px;\n      border-bottom: 1px solid #9a7a52;\n    }\n    .pf-feature-chips {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 8px;\n      margin: 10px 0 10px;\n    }\n    .pf-feature-chip {\n      display: inline-flex;\n      align-items: baseline;\n      column-gap: 4px;\n      padding: 6px 14px;\n      border-radius: 0px;\n      background: #fff;\n      border: 1px solid #C49B66;\n      font-size: 12px;\n      line-height: 1.4;\n      color: #1c1c1c;\n      white-space: nowrap;\n    }\n    .pf-feature-chip.is-hidden {\n      display: none;\n    }\n    .pf-feature-chip-main {\n      font-weight: 600;\n    }\n    .pf-feature-chip-sub {\n      color: #777;\n    }\n    .pf-feature-toggle {\n      display: inline-flex;\n      align-items: center;\n      gap: 4px;\n      background: none;\n      border: none;\n      padding: 0;\n      margin: 0 0 18px;\n      cursor: pointer;\n      font-size: 12px;\n      font-weight: 500;\n      color: #9a7a52;\n      letter-spacing: 0.04em;\n      text-transform: uppercase;\n      font-family: inherit;\n    }\n    .pf-feature-toggle:hover {\n      color: #7a5f3e;\n    }\n    .pf-feature-toggle .pf-toggle-arrow {\n      display: inline-block;\n      transition: transform 0.2s ease;\n      font-size: 10px;\n      line-height: 1;\n    }\n    .pf-feature-toggle.is-expanded .pf-toggle-arrow {\n      transform: rotate(180deg);\n    }\n    @media (max-width: 480px) {\n      .pf-feature-chip {\n        white-space: normal;\n      }\n    }\n  </style>\n\n  <p class=\"pf-section-label\">Key Features</p>\n\n  {% assign feature_count = product.metafields.custom.features.value | size %}\n\n  <div class=\"pf-feature-chips\" data-visible-count=\"4\">\n    {% for feature in product.metafields.custom.features.value %}\n      {% assign parts = feature | split: \"|\" %}\n      <div class=\"pf-feature-chip{% if forloop.index > 4 %} is-hidden{% endif %}\">\n        <span class=\"pf-feature-chip-main\">{{ parts[0] | strip }}</span>\n      </div>\n    {% endfor %}\n  </div>\n\n  {% if feature_count > 4 %}\n    <button\n      type=\"button\"\n      class=\"pf-feature-toggle\"\n      data-expanded=\"false\"\n      aria-expanded=\"false\"\n      onclick=\"\n        var btn = this;\n        var wrap = btn.previousElementSibling;\n        var expanded = btn.getAttribute('data-expanded') === 'true';\n        var chips = wrap.querySelectorAll('.pf-feature-chip');\n        chips.forEach(function(chip, i){\n          if (i >= 4) chip.classList.toggle('is-hidden', expanded);\n        });\n        btn.setAttribute('data-expanded', !expanded);\n        btn.setAttribute('aria-expanded', !expanded);\n        btn.classList.toggle('is-expanded', !expanded);\n        btn.querySelector('.pf-toggle-label').textContent = expanded ? 'See more' : 'See less';\n      \"\n    >\n      <span class=\"pf-toggle-label\">See more</span>\n      <span class=\"pf-toggle-arrow\">▾</span>\n    </button>\n  {% endif %}\n{% endif %}"
